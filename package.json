{
  "name": "reading-record",
  "version": "0.1.0",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "test": "npm run build && node --test tests/*.test.mjs",
    "dev": "wrangler dev --ip 127.0.0.1 --port 8787",
    "build": "vite build && node scripts/service-worker.mjs",
    "check": "tsc --noEmit",
    "db:local": "wrangler d1 migrations apply DB --local"
  },
  "type": "module",
  "dependencies": {
    "@tanstack/react-query": "5.107.1",
    "hono": "4.13.18",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261115.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "miniflare": "5.20261113.0-beta",
    "playwright": "1.65.1",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "wrangler": "4.162.0"
  },
  "private": true
}
